# Backend
# Local geliştirme:
DATABASE_URL=postgresql://user:password@localhost:5432/marketapp
# Production (Supabase): Project Settings > Database > Connection string (Transaction pooling modu)
# DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

JWT_SECRET=
PORT=3000

# Web Push (npx web-push generate-vapid-keys ile üret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@marketapp.dev

# Supabase Storage (ürün görselleri + profil fotoğrafı yükleme)
# Boşsa /uploads/* endpoint'leri 503 döner, yükleme devre dışı kalır.
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > service_role (GİZLİ, asla client'a verme)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=market-assets

# Payment provider (to be decided: iyzico / PayTR / Stripe)
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
